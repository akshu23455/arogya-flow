# Core security (generate long random values; never commit real secrets)
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WORKER_SECRET=replace-with-a-long-random-worker-secret

# LLM - any OpenAI-compatible chat-completions endpoint
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=ArogyaFlow <appointments@example.com>

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Allows notification delivery to succeed without providers during local demos
DEMO_MODE=true
